; Engine configuration file.
; Pinned engine: Godot 4.7.2-stable (official), Compatibility renderer.

config_version=5

[application]

config/name="Backstreet Oath"
config/description="An original belt-scrolling action RPG set in Bellwether, 1988."
config/version="1.0.0-rc4"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.png"
boot_splash/bg_color=Color(0.101961, 0.0705882, 0.12549, 1)
boot_splash/show_image=false

[autoload]

Content="*res://scripts/autoload/content.gd"
Settings="*res://scripts/autoload/settings.gd"
GameState="*res://scripts/autoload/game_state.gd"
SaveService="*res://scripts/autoload/save_service.gd"
Audio="*res://scripts/autoload/audio_service.gd"
InputPrompts="*res://scripts/autoload/input_prompts.gd"
SceneFlow="*res://scripts/autoload/scene_flow.gd"
Quests="*res://scripts/autoload/quests.gd"
Story="*res://scripts/autoload/story.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.101961, 0.0705882, 0.12549, 1)

[debug]

gdscript/warnings/inference_on_variant=1
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_local_constant=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/untyped_declaration=0
gdscript/warnings/unsafe_property_access=0
gdscript/warnings/unsafe_method_access=0
gdscript/warnings/unsafe_cast=0
gdscript/warnings/unsafe_call_argument=0
gdscript/warnings/confusable_local_declaration=0
gdscript/warnings/shadowed_global_identifier=0
